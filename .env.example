# Copy to .env and fill in what you need. .env is gitignored; never commit a key.

# Without this the application runs, and every decision comes from the fixed
# rules. With it, a run can be started on Jev instead. The key is read by the
# host process and never reaches a browser.
TYPESAFE_API_KEY=

# Optional. The defaults are shown.
# PORT=8787

# The host binds loopback only, because nothing here asks for a password.
# Setting this exposes every run on this machine to anyone who can reach the
# port. Do it deliberately or not at all.
# JEV_MICE_HOST=127.0.0.1
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_MICE_MAX_RUNS=4
# JEV_MICE_DATA=./.data
# JEV_MICE_WEB=./apps/web/dist
